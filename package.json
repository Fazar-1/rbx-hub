{
  "name": "rbx-hub",
  "version": "1.4.0",
  "description": "RBX Hub — каталог игр Roblox",
  "main": "main.js",
  "author": "RBX Hub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:ui": "node scripts/build-ui.cjs",
    "dist": "electron-builder --win --linux --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rbxhub.app",
    "productName": "RBX Hub",
    "copyright": "RBX Hub",
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.ico",
      "ui/**/*"
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RBX Hub",
      "artifactName": "RBX-Hub-Setup-1.4.0.exe",
      "language": "1049"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "synopsis": "Каталог игр Roblox",
      "description": "RBX Hub — каталог игр Roblox с поиском, фильтрами и живыми данными",
      "artifactName": "RBX-Hub-1.4.0-${arch}.${ext}",
      "maintainer": "RBX Hub"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "RBX-Hub-1.4.0-${arch}.${ext}"
    }
  }
}
